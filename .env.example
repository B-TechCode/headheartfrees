# HeadHeartFreeS - example environment
# Copy to .env and fill in real values. NEVER commit .env.
#
# Variables are grouped by the phase that starts using them. Anything marked
# "unused in phase 1" is here so the file stays the single reference for
# deployment; the backend does not read it yet.

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose service `db`) - consumed by Postgres itself now,
# by the backend from phase 4 onward.
# ---------------------------------------------------------------------------
POSTGRES_DB=headheartfrees
POSTGRES_USER=headheartfrees
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Backend datasource. Unused in phase 1 (no JPA/driver on the classpath yet).
# Host `db` is the compose service name; use localhost when running the jar
# directly against a compose-exposed Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/headheartfrees
SPRING_DATASOURCE_USERNAME=headheartfrees
SPRING_DATASOURCE_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Comma-separated list of origins allowed to call the API with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth - live from phase 5.
#
# APP_JWT_SECRET must decode to at least 256 bits for HS256. A raw passphrase
# of 32+ characters is accepted too, but base64 is what the app documents:
#   openssl rand -base64 48
#
# There IS a working default in application.yml so a fresh clone starts. It is
# committed, so it is public, and it must be replaced anywhere real - the
# backend now refuses to start on it unless SPRING_PROFILES_ACTIVE=local.
# ---------------------------------------------------------------------------
APP_JWT_SECRET=replace-with-base64-encoded-256-bit-secret
APP_JWT_ACCESS_TOKEN_TTL=PT15M
APP_JWT_REFRESH_TOKEN_TTL=P30D

# Whether the refresh cookie carries `Secure`. Leave true: browsers treat
# localhost as a secure context, so it works over plain HTTP there. Set false
# only for a LAN-IP deployment with no TLS.
APP_COOKIE_SECURE=true

# The ONLY path to an ADMIN role, and it is not a credential.
#
# Comma-separated. At startup, any account that ALREADY EXISTS at one of these
# addresses is promoted to ADMIN. It never creates an account, so setting this
# to an unregistered address does nothing. The sequence is:
#   1. register through POST /api/v1/auth/register
#   2. set this variable to that address
#   3. restart the backend
# No endpoint anywhere accepts a role in its request body.
APP_ADMIN_BOOTSTRAP_EMAILS=

# ---------------------------------------------------------------------------
# Google sign-in - OPTIONAL. Leave both blank and the app starts normally with
# no Google option; password login is unaffected. Both must be set for the
# registration to be created at all (see GoogleOAuth2EnvironmentPostProcessor).
#
# Renamed in phase 5 from GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET,
# which were phase-1 placeholders that nothing ever read. These names match the
# labels in the Google Cloud Console.
#
# Where to get them:
#   Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   Authorised redirect URI:  http://localhost:8080/login/oauth2/code/google
#   Authorised JS origin:     http://localhost:3000
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sign-in sends the browser once the refresh cookie is set. No
# token is ever placed in this URL - the frontend calls /api/v1/auth/refresh to
# exchange the cookie for an access token. Phase 6 builds that page.
APP_OAUTH2_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

# Peers allowed to speak for a client behind them via X-Forwarded-For, so the
# rate limiter can tell users apart instead of lumping everyone behind the
# proxy into one bucket.
#
# EMPTY BY DEFAULT and that is the safe direction. Behind a reverse proxy, set
# this to that proxy's address. Leave it empty and everyone behind the proxy
# shares one bucket - bad, but survivable. Trust the header without naming the
# proxy and any caller bypasses the limiter entirely by varying it, which is
# not survivable. Exact addresses only: no CIDR, never a wildcard.
APP_RATE_LIMIT_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Frontend
#
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at BUILD time,
# not read at runtime. Changing this requires rebuilding the frontend image
# (docker compose build frontend), not just restarting the container.
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Whether the frontend draws the "Continue with Google" button.
#
# This must agree with GOOGLE_CLIENT_ID above, and it is a second setting
# rather than one because the backend has no endpoint yet that says which
# sign-in providers it has configured (phase 7 should add one). Getting it
# wrong is visible, not silent:
#
#   true, backend not configured  -> the button leads to a 404
#   false, backend configured     -> no button; password sign-in still works
#
# Build time, like every NEXT_PUBLIC_* value: `docker compose build frontend`.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# ---------------------------------------------------------------------------
# Security headers - phase 9. BOTH ARE BUILD TIME.
#
# Next resolves headers() when it builds, so changing either needs
# `docker compose build frontend`, not a restart.
# ---------------------------------------------------------------------------

# Sends the Content-Security-Policy as Content-Security-Policy-Report-Only,
# which logs violations to the browser console without blocking anything. Use
# it to verify a policy change against a real browser before enforcing it.
# NEVER true in a deployed build.
CSP_REPORT_ONLY=false

# Strict-Transport-Security.
#
# LEAVE THIS FALSE UNTIL TLS IS CONFIRMED WORKING, and prefer setting the
# header at the TLS terminator instead. Enabling it is close to irreversible:
# a browser that has seen it refuses plain HTTP to this host for the length of
# max-age (one year here), so a certificate problem afterwards locks visitors
# out rather than degrading. It goes on last. See HANDOVER section 3.
ENABLE_HSTS=false
