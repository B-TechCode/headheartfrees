<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.headheartfrees</groupId>
  <artifactId>headheartfrees-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>headheartfrees-backend</name>
  <description>HeadHeartFreeS backend - anonymous emotional release</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.9.0</springdoc.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <archunit.version>1.4.1</archunit.version>
    <bouncycastle.version>1.78.1</bouncycastle.version>
    <java-otp.version>1.0.0</java-otp.version>
    <qrcodegen.version>1.8.0</qrcodegen.version>
  </properties>

  <dependencies>
    <!--
      Phase 1 kept the classpath small so the app started with no database.
      Phase 4 introduces the first table, so persistence arrives here: JPA, the
      PostgreSQL driver and Flyway. This was originally scheduled with auth, and
      moved forward when the vent flow was reordered ahead of it — vent_events is
      now the first table the application needs.

      Still deferred: jjwt and the OAuth2 client (phase 5, auth backend).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Phase 5 auth.

      oauth2-client provides the Google sign-in flow. It is on the classpath
      unconditionally, but Spring only builds a ClientRegistrationRepository
      when the registration properties are actually set, so an install with no
      GOOGLE_CLIENT_ID still starts - see SecurityConfig, which takes that
      repository as an ObjectProvider rather than a hard dependency.

      oauth2-jose is pulled in transitively by oauth2-client, and is declared
      explicitly because JwtService depends on it directly for HS256 signing
      and verification. Relying on a transitive path for a direct compile
      dependency is how a build breaks when an unrelated starter is removed.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <!--
      Argon2id. Spring Security's Argon2PasswordEncoder delegates to
      BouncyCastle and throws at construction time without it on the classpath.
      Chosen over BCrypt because BCrypt silently truncates input at 72 bytes,
      which would quietly cap the "no maximum below 64 characters" policy for
      any non-Latin script. See PasswordPolicy.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway needs its Postgres module as a separate artifact from 10.x onward;
      flyway-core alone cannot resolve the postgresql:// dialect at runtime.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- In-memory token buckets for per-IP rate limiting. No datastore. -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!--
      TOTP (RFC 6238), for the second factor on sign-in.

      Chosen over writing the step arithmetic by hand, and over the two
      obvious alternatives:

        dev.samstevens.totp   last released November 2020, and pulls zxing
                              plus commons-codec behind it.
        com.atlassian:onetime maintained, but Kotlin - kotlin-stdlib would
                              enter a Java-only runtime image for one
                              algorithm.

      java-otp is MIT, ~20KB, and has ZERO compile or runtime dependencies:
      every <dependency> in its own POM is test scope. It does one thing -
      derive a code from a key and an instant over javax.crypto.Mac - and has
      no opinion about storage, Spring, or QR codes.
    -->
    <dependency>
      <groupId>com.eatthepath</groupId>
      <artifactId>java-otp</artifactId>
      <version>${java-otp.version}</version>
    </dependency>

    <!--
      QR encoding for the enrolment screen, rendered to an SVG data: URI by
      TotpQrCode.

      Last released April 2022, and that is NOT rot. QR is a frozen ISO
      specification (ISO/IEC 18004) and this is a complete, finished
      implementation of it by Project Nayuki with no dependencies and nothing
      left to track. There is no upstream moving underneath it. Judge it on
      whether it still encodes the spec, which it does, rather than on the
      date - and see PHASE_LOG for why that distinction was made deliberately
      rather than overlooked.

      It lives on the backend, not the frontend, for two reasons: the frontend
      has zero runtime dependencies today and that is worth keeping, and the
      production CSP is `style-src 'self'` with no 'unsafe-inline' (verified
      in phase 9), which a client-side QR component would be one inline style
      away from breaking. An <img src="data:image/svg+xml;base64,..."> is
      already covered by the existing `img-src 'self' data:`.
    -->
    <dependency>
      <groupId>io.nayuki</groupId>
      <artifactId>qrcodegen</artifactId>
      <version>${qrcodegen.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Migrations run against real Postgres in tests, not H2. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Enforces PROJECT_BRIEF.md rule 2.1 as a build failure rather than a
      comment. See VentRuleArchitectureTest.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Surefire's default includes do not match *IT.java, and without failsafe
        nothing else does either, so `mvnw verify` was compiling the phase-4
        integration tests and then never running them. Found during phase 4
        verification: the suite reported 13 green tests and BUILD SUCCESS while
        VentControllerIT, VentErrorHandlingIT and VentSchemaIT — including the
        one assertion that vent_events has no content column — sat unexecuted.
        A guard that does not run is worse than no guard, because it reads as
        one in the log.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Definition of done: compiles with zero warnings. -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
